{
  "$schema": "https://app.kilo.ai/config.json",

  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },

  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-haiku-4-5-20251001",

  "hide_prompt_training_models": true,
  "auto_collapse_reasoning": true,
  "terminal_command_display": "collapsed",

  "compaction": {
    "auto": true,
    "threshold_percent": 75
  },

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",

    "edit": "ask",
    "task": "ask",
    "websearch": "ask",
    "doom_loop": "deny",

    "bash": {
      "*": "ask",
      "cd *": "allow",
      "pwd": "allow",
      "ls *": "allow",
      "Get-Location": "allow",
      "Get-ChildItem *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow"
    }
  },

  "experimental": {
    "openTelemetry": false
  }
}
